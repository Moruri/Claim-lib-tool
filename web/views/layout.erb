<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Claim library</title>
  <link rel="stylesheet" href="/style.css">
  <% if @job && @job[:running] %><meta http-equiv="refresh" content="3"><% end %>
</head>
<body>
  <header class="top">
    <a class="brand" href="/">Claim library</a>
    <% if @name %>
      <nav>
        <a href="/libraries/<%= h @name %>"><%= h @name %></a>
        <a href="/libraries/<%= h @name %>/next">Judge next</a>
        <a href="/libraries/<%= h @name %>/report">Report</a>
        <a href="/libraries/<%= h @name %>/benchmark">Benchmark</a>
      </nav>
    <% end %>
  </header>
  <main><%= yield %></main>
</body>
</html>
